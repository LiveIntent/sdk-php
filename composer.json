{
    "name": "liveintent/sdk-php",
    "description": "LiveIntent SDK PHP",
    "keywords": [
        "liveintent",
        "sdk",
        "php"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1|^8.2",
        "guzzlehttp/guzzle": "^7.3",
        "illuminate/collections": "^11.0",
        "illuminate/contracts": "^11.0",
        "illuminate/http": "^11.0",
        "illuminate/support": "^11.0",
        "nesbot/carbon": "^2.46"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.0",
        "ramsey/conventional-commits": "^1.1",
        "symfony/var-dumper": "^6.0",
        "symfony/finder": "^7.0",
        "vimeo/psalm": "^5.0",
        "vlucas/phpdotenv": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "LiveIntent\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "scripts": {
        "psalm": "vendor/bin/psalm",
        "lint": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
        "test": "vendor/bin/phpunit",
        "test-watch": "vendor/bin/phpunit-watcher watch",
        "test-record": "RECORD_SNAPSHOTS=true USE_SNAPSHOTS=false vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
